# Browser configuration. Anything prefixed VITE_ is compiled into the
# JavaScript the browser downloads, so it must never hold a secret.
VITE_SPOTIFY_CLIENT_ID=
# Optional. Leave blank to use the current app origin in local development.
# In Vercel Production, set this to the exact HTTPS callback URL, for example https://your-domain.example/callback.
VITE_SPOTIFY_REDIRECT_URI=
VITE_ENABLE_PANEL_REPORT=false

VITE_TLDRAW_LICENSE_KEY=

# Server-only configuration, for the Spotify catalog search and the curated
# playlist suggestions the Music panel offers before anyone connects Spotify.
# These are read by the functions in api/ and by the dev server; they are
# never sent to the browser. Do NOT add a VITE_ prefix to either of them, and
# never create a VITE_SPOTIFY_CLIENT_SECRET.
#
# SPOTIFY_CLIENT_ID is the same Client ID as above; it is repeated without the
# prefix because the server reads its own variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
