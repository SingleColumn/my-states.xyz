# Browser configuration. Anything prefixed VITE_ is compiled into the
# JavaScript the browser downloads, so it must never hold a secret.
# Optional, local copies only. A local copy opened at another loopback address
# (localhost vs 127.0.0.1) is moved to this one, so its boards are always the
# same set. It was Spotify's sign-in return address when the Music panel could
# connect an account (docs/spotify-sdk-approach.md).
VITE_SPOTIFY_REDIRECT_URI=
VITE_ENABLE_PANEL_REPORT=false

# Optional public root URL of the curated image export. Leave blank to use
# the bundled sample collections. Do not use the image-collections website
# URL unless it serves collections/index.json from this root.
VITE_IMAGE_COLLECTIONS_BASE_URL=

VITE_TLDRAW_LICENSE_KEY=

# Server-only configuration, for the Spotify catalog search and the curated
# playlist suggestions the Music panel offers.
# These are read by the functions in api/ and by the dev server; they are
# never sent to the browser. Do NOT add a VITE_ prefix to either of them, and
# never create a VITE_SPOTIFY_CLIENT_SECRET.
#
# SPOTIFY_CLIENT_ID is the Client ID of the Spotify app in the developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
