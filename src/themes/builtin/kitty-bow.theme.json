{
  "schemaVersion": 1,
  "id": "kitty-bow",
  "name": "Kitty Bow",
  "version": "1.1.0",
  "author": "my-states",
  "description": "Inspired by a certain white cat with a red bow: white panels with pink trim, a bow-red accent, gold details, bubbly rounded corners and type, polka dots and a soft pink glow. Light mode only.",
  "modes": {
    "light": {
      "foundation": {
        "color": {
          "background": "#ffe9f0",
          "foreground": "#4a2b35",
          "muted": "rgba(74, 43, 53, 0.62)",
          "faint": "rgba(74, 43, 53, 0.42)",
          "accent": "#e5395f",
          "border": "rgba(229, 57, 95, 0.22)",
          "danger": "#d7263d",
          "selection": "#e5395f"
        },
        "typography": {
          "uiFont": "\"Varela Round\", Nunito, Quicksand, \"Comic Sans MS\", \"Trebuchet MS\", \"Segoe UI\", sans-serif",
          "headingFont": "\"Baloo 2\", Baloo, Fredoka, \"Varela Round\", Nunito, \"Comic Sans MS\", \"Trebuchet MS\", sans-serif"
        },
        "shape": {
          "radiusLarge": "30px",
          "radiusMedium": "18px",
          "radiusSmall": "14px"
        },
        "depth": {
          "shadowSmall": "0 0 0 3px rgba(255, 255, 255, 0.7), 0 8px 20px rgba(229, 57, 95, 0.14)",
          "shadowMedium": "0 0 0 3px rgba(255, 255, 255, 0.7), 0 10px 26px rgba(229, 57, 95, 0.14)",
