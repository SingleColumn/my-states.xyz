          "border": "rgba(229, 57, 95, 0.3)",
          "backdrop": "rgba(229, 57, 95, 0.22)"
        },
        "spotify": {
          "accent": "#ff6f91",
          "panelBackground": "#ffd9e3",
          "playlistRowBackground": "#fff"
        },
        "images": {
          "accent": "#e5395f",
          "panelBackground": "#ffdbe4",
          "frameBorder": "6px solid #fff",
          "frameShadow": "0 0 0 2px #ffc6d5, 0 8px 20px rgba(229, 57, 95, 0.18)"
