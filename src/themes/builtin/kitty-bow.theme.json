        "borderSubtle": "rgba(229, 57, 95, 0.12)",
        "borderNormal": "rgba(229, 57, 95, 0.28)",
        "borderStrong": "rgba(229, 57, 95, 0.45)",
        "focusRing": "#f2c14e",
        "interactive": "rgba(255, 255, 255, 0.7)",
        "interactiveHover": "#ffe1ea",
        "interactiveActive": "#ffd0dd"
      },
      "components": {
        "canvas": {
          "backdrop": "radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.9), transparent 28%), radial-gradient(circle at 82% 12%, rgba(255, 214, 226, 0.9), transparent 30%), linear-gradient(135deg, #ffe4ec 0%, #fff4f8 52%, #ffdde7 100%)",
          "gridColor": "rgba(229, 57, 95, 0.07)",
