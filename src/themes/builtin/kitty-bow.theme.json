          "border": "rgba(229, 57, 95, 0.25)",
          "foreground": "#e5395f",
          "backgroundHover": "#ffe1ea",
          "backgroundActive": "#ffd0dd",
          "borderActive": "#f2c14e",
          "foregroundActive": "#c92a4e"
        },
        "control": {
